{
  "name": "co-platform",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc --build",
    "clean": "tsc --build --clean",
    "test": "npm run build && node --test packages/*/dist/**/*.test.js",
    "typecheck": "tsc --build --dry",
    "web": "npm run build && npm --workspace @co/mobile exec -- expo export --platform web",
    "serve": "npx serve -l 8080 -s apps/mobile/dist",
    "shot": "node tools/screenshot.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.7.5",
    "playwright": "^1.63.0",
    "typescript": "^5.6.3"
  }
}