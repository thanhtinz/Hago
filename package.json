{
  "name": "co-platform",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc --build",
    "clean": "tsc --build --clean",
    "test": "tsc --build --force && node --test packages/*/dist/**/*.test.js apps/server/dist/**/*.test.js",
    "typecheck": "tsc --build --force && tsc --noEmit -p apps/mobile",
    "web": "npm run build && npm --workspace @co/mobile exec -- expo export --platform web",
    "serve": "npx serve -l 8080 -s apps/mobile/dist",
    "shot": "node tools/screenshot.mjs",
    "start": "npm run web && sh tools/chay.sh",
    "kiem-giao-dien": "for f in screenshot two-players rematch sanh bxh taikhoan thongbao camgiac bienban avatar history friends chat; do node tools/$f.mjs || exit 1; done"
  },
  "devDependencies": {
    "@types/node": "^22.7.5",
    "@types/ws": "^8.18.1",
    "playwright": "^1.63.0",
    "serve": "^14.2.6",
    "typescript": "^5.6.3",
    "wait-on": "^9.1.0"
  }
}
